# Salin ke .env (jangan di-commit). Di Vercel isi lewat Settings -> Environment Variables.
DATABASE_URL=mysql://user:password@host:4000/dbname
DATABASE_SSL=true
# Hash password admin: jalankan `npm run hash-password` lalu tempel hasilnya
ADMIN_PASSWORD_HASH=
# Password Admin Undangan (hanya menu undangan digital). Buat dengan: npm run hash-password:undangan
INVITATION_ADMIN_PASSWORD_HASH=
# Rahasia acak untuk hashing IP (min 32 karakter): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
BLOB_READ_WRITE_TOKEN=
# Domain yang diizinkan mengirim request admin
ALLOWED_ORIGIN=https://www.dyflorist.site
# Email pemulihan saat login admin diblokir (https://resend.com, gratis). Tanpa ini, link pemulihan hanya tercatat di log Vercel.
RESEND_API_KEY=
ALERT_EMAIL=dyfloristparcel@gmail.com
SITE_URL=https://www.dyflorist.site
